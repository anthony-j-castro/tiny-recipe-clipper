{
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": ["es5", "dom"],
    "module": "ESNext",
    "paths": {
      "~/playwright/*": ["../playwright/*"],
      "~/src/*": ["../src/*"]
    },
    "resolveJsonModule": true,
    "target": "ES2020",
    "types": ["chrome", "node"]
  },
  "include": ["**/*.ts"]
}
